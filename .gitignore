# Secrets -- never commit
.env
.env.*
!.env.example
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Local scratch
*.log
.DS_Store
data/_raw/

# Generated by the ETL -- never commit customer data to git history,
# especially on a public repo. The Action rebuilds it on every deploy.
web/data/*.json

# Generated by etl/probe.py -- a dump of the production schema.
# Useful locally, not something to publish in a public repo.
docs/schema_db*.json
