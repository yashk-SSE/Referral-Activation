# Copy to .env and fill in. .env is gitignored -- never commit the real key.
# In GitHub Actions these come from repository Secrets instead.

METABASE_URL=https://metabase.yourcompany.com
METABASE_API_KEY=mb_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
METABASE_DATABASE_ID=1

# Rolling window for the cohort analysis
LOOKBACK_MONTHS=24

# --- Google Sheets export (optional, etl/export_sheet.py) ------------------
# The Pages dashboard is public and carries no identity. The named customer
# sheet goes to Google instead, restricted to the SolarSquare Workspace domain.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- GitHub (optional) ----------------------------------------------------
# Raises the API rate limit from 60/hr to 5,000/hr for CI polling.
# Fine-grained token, Actions: Read + Contents: Read on this repo.
GITHUB_TOKEN=
